# Copier vers backend/.env et renseigner.
# Sans DATABASE_URL, Django utilise SQLite (db.sqlite3) en local.

# --- Base Postgres Supabase (projet "perinea") ---
# Dashboard Supabase > bouton "Connect" > onglet "ORM" / "psql".
# Utilise de préférence la connexion "Session pooler" (port 5432, compatible IPv4).
# Remplace [PASSWORD] par le mot de passe de la base (Connect > Database password).
#
# Exemple (Session pooler) :
# DATABASE_URL=postgresql://postgres.mwspsibzxhsjitkuisxy:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
#
# Exemple (connexion directe) :
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.mwspsibzxhsjitkuisxy.supabase.co:5432/postgres
DATABASE_URL=

# --- Django (optionnel) ---
# (voir section Sécurité ci-dessous)


# --- Sécurité (OBLIGATOIRE en production) ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
# Par défaut DEBUG=False. Mettre True uniquement en développement local.
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.mondomaine.fr
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.mondomaine.fr
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.mondomaine.fr
# DJANGO_ADMIN_URL=un-chemin-difficile-a-deviner/
# DJANGO_BEHIND_PROXY=True        # si TLS terminé par un reverse-proxy
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=14
# Chiffrement des données de santé (OBLIGATOIRE en production, à sauvegarder !)
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : nouvelle_clé,ancienne_clé
# FIELD_ENCRYPTION_KEYS=
